# Copy this file to .env and fill in real values.
# .env itself is gitignored and must NEVER be committed.

# Port the server listens on locally. Render sets its own PORT automatically
# in production - you don't need to set this on Render.
PORT=5001

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app-name>

# Any long random string - used to sign login tokens
JWT_SECRET=replace_with_a_long_random_string

# Gmail account used to send emails (welcome emails, contact form notifications)
# SMTP_PASSWORD must be a Gmail "App Password", not your normal Gmail password:
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=youraddress@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Where "Contact Us" form submissions get emailed to
ADMIN_EMAIL=youraddress@gmail.com

# Your deployed frontend URL(s), comma-separated if more than one
# (e.g. production + a preview URL). Required for CORS to allow your
# Vercel frontend to call this API.
CLIENT_URL=https://your-frontend.vercel.app
