# Copy this file to .env and fill in real values.
# .env itself is gitignored and must NEVER be committed.

# Port the server listens on locally. Render sets its own PORT automatically
# in production - you don't need to set this on Render.
PORT=5001

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app-name>

# Any long random string - used to sign login tokens
JWT_SECRET=replace_with_a_long_random_string

# Brevo (Sendinblue) SMTP credentials - used to send OTP, welcome, and
# contact-form-notification emails. Get these from Brevo -> SMTP & API ->
# SMTP tab (BREVO_LOGIN is the "Login" value, BREVO_SMTP_KEY is the "Key" /
# master password shown there, NOT your Brevo account password).
BREVO_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key

# The "From" address emails are actually sent as. This MUST be added and
# verified as a sender in Brevo (Senders, Domains & Dedicated IPs -> Senders)
# or Brevo will accept the send request but silently drop the email -
# this is the most common cause of "OTP says sent but never arrives".
BREVO_FROM_EMAIL=youraddress@example.com

# Where "Contact Us" form submissions get emailed to
ADMIN_EMAIL=youraddress@example.com

# Your deployed frontend URL(s), comma-separated if more than one
# (e.g. production + a preview URL). Required for CORS to allow your
# Vercel frontend to call this API.
CLIENT_URL=https://your-frontend.vercel.app

# Unpaid UPI orders are auto-cancelled (stock returned) after this many hours. 0 = never.
AUTO_CANCEL_UNPAID_HOURS=48

# Public URL of the storefront, used for links inside emails (defaults to the first CLIENT_URL)
SITE_URL=https://your-frontend.vercel.app

# Set this on your host (Render sets RENDER=true automatically). In production the server refuses a
# JWT_SECRET shorter than 32 characters and does not allow the localhost CORS origin.
NODE_ENV=production

# Most unpaid/undelivered orders one account may have open at the same time (default 5)
MAX_OPEN_ORDERS=5
