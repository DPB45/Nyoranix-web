# Copy this file to .env and fill in real values for local development.
# .env itself is gitignored.
#
# In production, set this in Vercel's Project Settings > Environment Variables
# instead of committing it - point it at your deployed Render backend URL.

VITE_API_URL=http://localhost:5001

# Your real GSTIN, printed on invoices. Leave empty to omit the GSTIN line.
VITE_GSTIN=
